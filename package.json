{
  "name": "billing-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Billing Hub — format-agnostic bridge between counter-printed bills and a customer-owned archive (India-first).",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "bin": {
    "billing-hub-agent": "./dist/agent/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/api/main.ts",
    "start": "node dist/api/main.js",
    "agent": "tsx src/agent/cli.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.2",
    "qrcode": "^1.5.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
